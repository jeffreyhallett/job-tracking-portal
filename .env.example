# Injected automatically by the Neon integration on Vercel; pull locally with `vercel env pull .env.local`
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Optional but recommended. Mixed into the session-token signature, so a read-only
# database leak cannot mint sessions. Any long random string: `openssl rand -hex 32`.
# Changing it signs every device out.
AUTH_SECRET=
# Optional. Where the Vite dev server proxies /api (default http://localhost:3000).
API_PROXY_TARGET=

# Accounts are created with `npm run user:add -- you@example.com`; passwords live
# in the database, hashed. There is no APP_PASSWORD any more.
# Agent tokens are per user too: mint one under Settings -> Automations in the app,
# or with `npm run user:agent-token -- you@example.com`. There is no AGENT_TOKEN.
