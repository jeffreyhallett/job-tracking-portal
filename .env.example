# Injected automatically by the Neon integration on Vercel; pull locally with `vercel env pull .env.local`
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Shared password for the app. Devices that enter it stay signed in until it changes.
APP_PASSWORD=change-me
# Optional. Token for scheduled Claude tasks / scripts (see docs/AGENT.md). At least 16 chars; try `openssl rand -hex 32`.
AGENT_TOKEN=
# Optional. The owner id every row belongs to until per-user auth exists (see api/_owner.ts). Defaults to "default".
DEFAULT_OWNER_ID=jeffrey
